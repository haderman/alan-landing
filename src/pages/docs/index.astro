---
import { getCollection } from "astro:content";
import DocsLayout from "../../layouts/DocsLayout.astro";

const docs = (await getCollection("docs"))
  .filter(({ data }) => !data.draft)
  .sort(
    (a, b) => a.data.order - b.data.order || a.id.localeCompare(b.id),
  );
---

<DocsLayout
  title="Alan AI Documentation"
  description="Learn how to install Alan AI, connect your OpenAI API key, and create AI chat agents in Visual Studio Code."
>
  <h2>Get started with Alan AI</h2>
  <p>
    Alan brings multiple AI chats directly into Visual Studio Code. Follow the
    guides below to install the extension, connect your OpenAI API key, and
    build a workflow that fits your projects.
  </p>

  <div class="doc-cards">
    {
      docs.map((doc) => (
        <a class="doc-card" href={`/docs/${doc.id}/`}>
          <span class="doc-card-group">{doc.data.group}</span>
          <strong>{doc.data.title}</strong>
          <span>{doc.data.description}</span>
        </a>
      ))
    }
  </div>
</DocsLayout>

<style>
  h2 {
    margin: 0 0 0.85rem;
    color: #f0f7fb;
    font-size: 1.65rem;
    line-height: 1.25;
  }

  p {
    max-width: 48rem;
    margin: 0 0 2rem;
  }

  .doc-cards {
    display: grid;
    gap: 1rem;
  }

  .doc-card {
    display: grid;
    gap: 0.35rem;
    padding: 1.15rem 1.25rem;
    border: 1px solid rgb(139 200 240 / 0.14);
    border-radius: 0.55rem;
    background: rgb(11 23 33 / 0.7);
    color: #d6e2ea;
  }

  .doc-card:hover {
    border-color: rgb(139 200 240 / 0.4);
    text-decoration: none;
  }

  .doc-card strong {
    color: #f0f7fb;
    font-size: 1.1rem;
  }

  .doc-card-group {
    color: #8bc8f0;
    font-size: 0.72rem;
    font-weight: 700;
    letter-spacing: 0.08em;
    text-transform: uppercase;
  }

  .doc-card > span:last-child {
    color: #9eb1bd;
    font-size: 0.95rem;
  }
</style>